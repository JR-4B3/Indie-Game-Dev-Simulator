{
  "$schema": "https://opencode.ai/config.json",
  // Repository-local model metadata. Authentication remains in OpenCode's
  // credential store; no subscription keys are committed to this repository.
  "providers": {
    "opencode-go": {
      "models": {
        "deepseek-v4.1-flash": {
          "name": "DeepSeek V4.1 Flash (Go)",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 1000000,
            "output": 384000
          },
          "variants": [
            {
              "id": "low",
              "settings": {
                "reasoningEffort": "low"
              }
            },
            {
              "id": "high",
              "settings": {
                "reasoningEffort": "high"
              }
            },
            {
              "id": "max",
              "settings": {
                "reasoningEffort": "max"
              }
            }
          ]
        }
      }
    },
    "openrouter": {
      "models": {
        "deepseek/deepseek-v4.1-flash": {
          "name": "DeepSeek V4.1 Flash (OpenRouter fallback)",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "z-ai/glm-5.3-flash": {
          "name": "GLM-5.3 Flash (OpenRouter fallback)",
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "video"],
            "output": ["text"]
          }
        }
      }
    }
  }
}
